/* PerformanceProfiler.uss — Dense, technical, minimal chrome theme
   Small font, thin grid, tight bars.  */

.bar-graph--performance-profiler {
    /* ── Chrome colours ──────────────────────────────────────────────── */
    --bar-graph-bg-color:                rgb(8, 8, 13);
    --bar-graph-default-bar-color:       rgb(64, 153, 255);
    --bar-graph-axis-color:              rgb(77, 89, 115);
    --bar-graph-grid-line-color:         rgb(26, 26, 38);
    --bar-graph-hover-tint-color:        rgba(255, 255, 255, 0.18);
    --bar-graph-selection-fill-color:    rgba(255, 255, 255, 0.22);
    --bar-graph-selection-rim-color:     rgba(0, 230, 255, 0.9);
    --bar-graph-drag-rect-fill-color:    rgba(0, 179, 230, 0.08);
    --bar-graph-drag-rect-border-color:  rgba(0, 179, 230, 0.6);

    /* ── Chrome geometry ─────────────────────────────────────────────── */
    --bar-graph-axis-line-width:         1;
    --bar-graph-grid-line-width:         0.5;
    --bar-graph-bar-spacing-ratio:       0.05;
    --bar-graph-min-bar-width:           1;
    --bar-graph-padding-bottom:          32;
    --bar-graph-x-label-width:           40;
}

/* ── Label typography ────────────────────────────────────────────────── */
.bar-graph--performance-profiler .bar-graph__label--y,
.bar-graph--performance-profiler .bar-graph__label--x {
    color: rgb(166, 179, 204);
    font-size: 9px;
}
