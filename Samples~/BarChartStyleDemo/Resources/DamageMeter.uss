/* DamageMeter.uss — Bold, aggressive, warm/red theme
   Thick lines, uppercase labels, wide letter spacing.  */

.bar-graph--damage-meter {
    /* ── Chrome colours ──────────────────────────────────────────────── */
    --bar-graph-bg-color:                rgb(15, 8, 8);
    --bar-graph-axis-color:              rgb(102, 64, 64);
    --bar-graph-grid-line-color:         rgb(51, 20, 20);
    --bar-graph-selection-rim-color:     rgba(255, 77, 51, 0.9);

    /* ── Chrome geometry ─────────────────────────────────────────────── */
    --bar-graph-axis-line-width:         2;
    --bar-graph-grid-line-width:         1.5;
    --bar-graph-bar-spacing-ratio:       0.15;
    --bar-graph-padding-bottom:          56;
    --bar-graph-x-label-width:           80;
}

/* ── Label typography ────────────────────────────────────────────────── */
.bar-graph--damage-meter .bar-graph__label--y,
.bar-graph--damage-meter .bar-graph__label--x {
    color: rgb(217, 204, 191);
    font-size: 12px;
    -unity-font-style: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
}
