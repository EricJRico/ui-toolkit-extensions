/* Leaderboard.uss — Clean, cool/blue, precise theme
   Thin lines, tight spacing, smaller font.  */

.bar-graph--leaderboard {
    /* ── Chrome colours ──────────────────────────────────────────────── */
    --bar-graph-bg-color:                rgb(8, 8, 18);
    --bar-graph-default-bar-color:       rgb(99, 115, 140);
    --bar-graph-axis-color:              rgb(89, 97, 140);
    --bar-graph-grid-line-color:         rgb(20, 20, 41);
    --bar-graph-selection-rim-color:     rgba(51, 128, 255, 0.9);
    --bar-graph-drag-rect-fill-color:    rgba(51, 102, 230, 0.08);
    --bar-graph-drag-rect-border-color:  rgba(51, 102, 230, 0.6);

    /* ── Chrome geometry ─────────────────────────────────────────────── */
    --bar-graph-axis-line-width:         1;
    --bar-graph-grid-line-width:         0.5;
    --bar-graph-bar-spacing-ratio:       0.2;
    --bar-graph-padding-bottom:          56;
    --bar-graph-x-label-width:           72;
}

/* ── Label typography ────────────────────────────────────────────────── */
.bar-graph--leaderboard .bar-graph__label--y,
.bar-graph--leaderboard .bar-graph__label--x {
    color: rgb(204, 209, 242);
    font-size: 10px;
    -unity-font-style: normal;
    letter-spacing: 0.5px;
}
