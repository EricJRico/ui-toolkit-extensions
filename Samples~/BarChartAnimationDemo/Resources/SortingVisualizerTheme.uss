/* SortingVisualizerTheme.uss – Green terminal / matrix theme */

.bar-graph.sorting-visualizer-theme {
    /* ── Chrome colours ─────────────────────────────────────────────── */
    --bar-graph-bg-color:                rgb(5, 10, 5);
    --bar-graph-axis-color:              rgb(38, 77, 38);
    --bar-graph-grid-line-color:         rgb(15, 36, 15);
    --bar-graph-hover-tint-color:        rgba(77, 255, 77, 0.18);
    --bar-graph-selection-rim-color:     rgba(77, 255, 77, 0.9);
    --bar-graph-focus-rim-color:         rgb(128, 255, 128);
    --bar-graph-selection-fill-color:    rgba(77, 255, 77, 0.16);
    --bar-graph-drag-rect-fill-color:    rgba(77, 255, 77, 0.08);
    --bar-graph-drag-rect-border-color:  rgba(77, 255, 77, 0.6);

    /* ── Chrome geometry ────────────────────────────────────────────── */
    --bar-graph-bar-spacing-ratio:       0.05;
    --bar-graph-grid-line-width:         0.5;
    --bar-graph-axis-line-width:         1.5;
    --bar-graph-selection-rim-width:     1.5;

    /* ── Padding ────────────────────────────────────────────────────── */
    --bar-graph-padding-bottom:          12;
    --bar-graph-padding-left:            36;
    --bar-graph-padding-right:           12;
    --bar-graph-padding-top:             12;
}

/* ── Label typography ───────────────────────────────────────────────── */
.bar-graph.sorting-visualizer-theme .bar-graph__label--y,
.bar-graph.sorting-visualizer-theme .bar-graph__label--x {
    color: rgb(128, 230, 128);
    font-size: 10px;
    -unity-font-style: normal;
    letter-spacing: 0px;
}
