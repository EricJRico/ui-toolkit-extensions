/* RacingBarTheme.uss – Gold / amber market-cap race theme */

.bar-graph.racing-bar-theme {
    /* ── Chrome colours ─────────────────────────────────────────────── */
    --bar-graph-bg-color:                rgb(8, 10, 23);
    --bar-graph-axis-color:              rgb(153, 128, 64);
    --bar-graph-grid-line-color:         rgb(31, 31, 51);
    --bar-graph-hover-tint-color:        rgba(255, 230, 128, 0.18);
    --bar-graph-selection-rim-color:     rgba(230, 191, 51, 0.9);
    --bar-graph-focus-rim-color:         rgb(255, 230, 102);
    --bar-graph-selection-fill-color:    rgba(230, 191, 51, 0.16);
    --bar-graph-drag-rect-fill-color:    rgba(230, 191, 51, 0.08);
    --bar-graph-drag-rect-border-color:  rgba(230, 191, 51, 0.6);

    /* ── Chrome geometry ────────────────────────────────────────────── */
    --bar-graph-bar-spacing-ratio:       0.15;
    --bar-graph-grid-line-width:         0.75;
    --bar-graph-axis-line-width:         2;
    --bar-graph-selection-rim-width:     2;

    /* ── Padding ────────────────────────────────────────────────────── */
    --bar-graph-padding-bottom:          56;
    --bar-graph-padding-left:            56;
    --bar-graph-padding-right:           14;
    --bar-graph-padding-top:             14;

    /* ── Label layout ───────────────────────────────────────────────── */
    --bar-graph-x-label-width:           80;
}

/* ── Label typography ───────────────────────────────────────────────── */
.bar-graph.racing-bar-theme .bar-graph__label--y,
.bar-graph.racing-bar-theme .bar-graph__label--x {
    color: rgb(217, 209, 179);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
}
