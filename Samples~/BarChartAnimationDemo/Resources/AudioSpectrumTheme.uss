/* AudioSpectrumTheme.uss – Neon purple / magenta spectrum visualizer theme */

.bar-graph.audio-spectrum-theme {
    /* ── Chrome colours ─────────────────────────────────────────────── */
    --bar-graph-bg-color:                rgb(5, 3, 8);
    --bar-graph-axis-color:              rgb(38, 13, 51);
    --bar-graph-grid-line-color:         rgb(20, 10, 26);
    --bar-graph-hover-tint-color:        rgba(204, 77, 255, 0.18);
    --bar-graph-selection-rim-color:     rgba(204, 77, 255, 0.9);
    --bar-graph-focus-rim-color:         rgb(255, 128, 255);
    --bar-graph-selection-fill-color:    rgba(204, 77, 255, 0.16);
    --bar-graph-drag-rect-fill-color:    rgba(204, 77, 255, 0.08);
    --bar-graph-drag-rect-border-color:  rgba(204, 77, 255, 0.6);

    /* ── Chrome geometry ────────────────────────────────────────────── */
    --bar-graph-bar-spacing-ratio:       0.08;
    --bar-graph-min-bar-width:           2;
    --bar-graph-grid-line-width:         0.5;
    --bar-graph-axis-line-width:         1;
    --bar-graph-selection-rim-width:     1;

    /* ── Padding (tight – no axes/grid) ─────────────────────────────── */
    --bar-graph-padding-left:            12;
    --bar-graph-padding-right:           12;
    --bar-graph-padding-top:             8;
    --bar-graph-padding-bottom:          8;
}

/* ── Label typography ───────────────────────────────────────────────── */
.bar-graph.audio-spectrum-theme .bar-graph__label--y,
.bar-graph.audio-spectrum-theme .bar-graph__label--x {
    color: rgb(179, 128, 204);
    font-size: 9px;
    -unity-font-style: italic;
    letter-spacing: 2px;
    text-transform: uppercase;
}
