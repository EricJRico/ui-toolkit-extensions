/* BarGraph.uss  –  UI Toolkit Bar Graph V2
   All visual defaults; override freely in your own USS sheets.           */

.bar-graph {
    flex-grow: 1;
    min-width:  80px;
    min-height: 60px;
    border-radius: 4px;
    overflow: hidden;
    background-color: rgb(18, 18, 26);
    /* Hint: cursor should be pointer when EnableSelection is active.
       Unity 2023.1+ supports cursor: url(...) for custom cursors.        */
}

/* Label layer – overlays the Painter2D canvas, pointer events pass through */
.bar-graph__labels {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* Convenience size modifiers */
.bar-graph--compact { min-width: 120px; min-height: 80px; }
.bar-graph--fill    { width: 100%;      height: 100%;     }

/* Focused state (drawn by C# – this class can add a border if desired) */
.bar-graph:focus {
    /* Uncomment to show a focus outline via USS instead of C#:
    border-color: rgba(65, 150, 255, 0.6);
    border-width: 1px; */
}
